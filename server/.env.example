# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated origins for browser clients. Native Expo requests have no Origin header.
CLIENT_URL=http://localhost:8081,http://localhost:19006,http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/gebetago

# Required. Must be at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
